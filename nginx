sudo ln -s /etc/nginx/sites-available/hindichan.site /etc/nginx/sites-enabled/hindichan.site
sudo nginx -t

server {
    listen 80;
	listen [::]:80;
    server_name hindichan.site;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {

    listen 443 ssl;
	listen [::]:443 ssl;

	listen 443 quic reuseport;
    listen [::]:443 quic reuseport;

	http2 on;
    http3 on;

    server_name hindichan.site;

	client_max_body_size 15M;

    ssl_certificate /etc/letsencrypt/live/hindichan.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hindichan.site/privkey.pem;

	add_header Alt-Svc 'h3=":443"; ma=86400' always;

	location / {
        proxy_pass http://127.0.0.1:3000;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

		add_header Alt-Svc 'h3=":443"; ma=86400' always;

		# HTTPS security
		add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

		# Content security
		add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; font-src 'self' https: data:; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; object-src 'none'; script-src 'self'; script-src-attr 'none'; style-src 'self' https: 'unsafe-inline'; upgrade-insecure-requests" always;

		# Browser security
		add_header X-Content-Type-Options "nosniff" always;
		add_header X-Frame-Options "SAMEORIGIN" always;
		add_header Referrer-Policy "no-referrer" always;

		# Cross-origin isolation
		add_header Cross-Origin-Opener-Policy "same-origin" always;
		add_header Cross-Origin-Resource-Policy "same-origin" always;
		add_header Origin-Agent-Cluster "?1" always;

		# Additional protection
		add_header X-DNS-Prefetch-Control "off" always;
		add_header X-Download-Options "noopen" always;
		add_header X-Permitted-Cross-Domain-Policies "none" always;
		add_header X-XSS-Protection "0" always;
    }

    location /public/ {
		gzip off;
        alias /home/hindi/public/;
		add_header Alt-Svc 'h3=":443"; ma=86400' always;
        autoindex off;
    	sendfile on;
    	tcp_nopush on;
    	tcp_nodelay on;      
       	add_header Cache-Control "public, max-age=31536000" always;
		add_header X-Content-Type-Options "nosniff" always;
		add_header Content-Disposition "attachment" always;
    	try_files $uri =404;
    }

	location /static/ {
        alias /home/hindi/static/;
		add_header Alt-Svc 'h3=":443"; ma=86400' always;
		autoindex off;
        gzip on;
        gzip_comp_level 5;
        gzip_vary on;    
       	add_header Cache-Control "public, max-age=31536000" always;
    	try_files $uri =404;
    }

}